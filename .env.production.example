# ============================================================================
#  DigitaisBR — variáveis de produção
#
#  cp .env.production.example .env.production   e preencha TODOS os campos.
#  Este arquivo NÃO vai para o repositório (ver .gitignore).
# ============================================================================

# ---- domínio e TLS ----
DOMINIO=digitaisbr.com.br               # endereço oficial: serve o site
DOMINIO_ALT=digitaisbrinfluencers.com   # secundário: só redireciona para o oficial
EMAIL_TLS=admin@digitaisbr.com.br       # usado pelo Let's Encrypt para avisos

# ---- banco ----
# Com PostgreSQL gerenciado da DigitalOcean, apague o serviço `db` do compose
# e substitua a DATABASE_URL do serviço `api` pela string do cluster.
POSTGRES_USER=digitaisbr
POSTGRES_PASSWORD=            # openssl rand -base64 32
POSTGRES_DB=digitaisbr

# ---- segredos ----
# Gere cada um com:  openssl rand -base64 48
# NUNCA reaproveite os valores de desenvolvimento — eles estão no repositório.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- gate de acesso da plataforma ----
ACCESS_CODE=

# ---- limites ----
# 300 req/min por IP. Suba se o tráfego legítimo for maior.
THROTTLE_LIMIT=300
